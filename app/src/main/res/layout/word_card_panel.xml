<?xml version="1.0" encoding="utf-8"?>
<!-- M8 persistent word panel content (DESIGN.md §4.11), M16 editorial
     restyle (§4.18): Fraunces headword, uppercase-wide-tracked meta rows,
     hairline-separated gloss, ink-fill/outline button pair. The 2dp ink top
     rule lives in the container background (word_card_panel_bg). Plain
     appcompat widgets only — no Material dependency. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/word_card_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/fraunces_semibold"
            android:textColor="@color/hp_ink"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/word_card_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/hp_sub" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/word_card_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/word_card_phonetic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.06"
                android:textColor="@color/hp_sub"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/word_card_pos_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hp_sub"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/word_card_lemma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hp_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/word_card_collins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.1"
                android:textColor="@color/hp_ink"
                android:textSize="12sp" />

            <View
                android:id="@+id/word_card_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/hp_hairline" />

            <TextView
                android:id="@+id/word_card_miss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_in_dict"
                android:textColor="@color/hp_faint"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/word_card_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/hp_ink"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/word_card_definition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.5"
                android:maxLines="8"
                android:textColor="@color/hp_sub"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/word_card_add"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ink_fill"
            android:minHeight="0dp"
            android:text="@string/add_to_vocab"
            android:textAllCaps="false"
            android:textColor="@color/hp_paper"
            android:textSize="14sp" />

        <Button
            android:id="@+id/word_card_ai"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ink_outline"
            android:minHeight="0dp"
            android:text="@string/ask_ai"
            android:textAllCaps="false"
            android:textColor="@color/hp_ink"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>

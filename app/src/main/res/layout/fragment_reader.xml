<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/navigator_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:textIsSelectable="true" />

    <!-- M8 persistent word panel host (WordCardPanel): stays GONE until a
         lookup slides it up. Sits above the navigator but only covers the
         bottom strip, so the article remains fully interactive — no modal.
         M16: flat paper + 2dp ink top rule (word_card_panel_bg), elevation
         toned down — the ink rule, not a shadow, marks the edge. -->
    <FrameLayout
        android:id="@+id/word_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/word_card_panel_bg"
        android:elevation="4dp"
        android:visibility="gone" />

</FrameLayout>

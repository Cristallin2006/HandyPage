<?xml version="1.0" encoding="utf-8"?>
<!-- M16 word panel background (design-system.md §4.18): flat paper with the
     signature 2dp solid ink top rule — bottom surfaces rise behind the ink
     line, no rounded card, no floating shadow (elevation toned down on the
     container). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hp_paper" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="@color/hp_ink" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- M16 primary button (design-system.md §4.7): solid ink, 4dp corners.
     Disabled state falls back to faint grey. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/hp_faint" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/hp_ink" />
        </shape>
    </item>
</selector>
